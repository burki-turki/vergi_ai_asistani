{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "holiday_calendar.schema.json",

  "title": "Vergi AI Official Holiday Calendar Schema V2.1",

  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "calendar_id",
    "calendar_version",
    "effective_from",
    "jurisdiction",
    "weekend_policy",
    "half_day_policy",
    "years",
    "governance",
    "notes"
  ],

  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },

    "calendar_id": {
      "const": "tr_official_holiday_calendar_v1"
    },

    "calendar_version": {
      "type": "integer",
      "minimum": 1
    },

    "effective_from": {
      "type": "string",
      "format": "date"
    },

    "jurisdiction": {
      "const": "TR"
    },

    "weekend_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["non_working_weekdays", "notes"],
      "properties": {
        "non_working_weekdays": {
          "const": [5, 6]
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },

    "half_day_policy": {
      "type": "string",
      "enum": [
        "not_decided",
        "counts_as_holiday",
        "counts_as_working_day",
        "needs_review_if_deadline_day"
      ]
    },

    "years": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/year_entry"
      }
    },

    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_approval",
        "verification_authority",
        "notes"
      ],
      "properties": {
        "change_approval": {
          "type": "string",
          "minLength": 1
        },
        "verification_authority": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },

    "notes": {
      "type": ["string", "null"]
    },

    "verifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verification_record"
      }
    }
  },

  "$defs": {
    "year_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "verified",
        "verification_ref",
        "source_refs",
        "holidays"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "verified": {
          "type": "boolean"
        },
        "verification_ref": {
          "type": ["string", "null"]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "holidays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/holiday_entry"
          }
        }
      }
    },

    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "citation", "url"],
      "properties": {
        "source_kind": {
          "type": "string",
          "minLength": 1
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": ["string", "null"]
        }
      }
    },

    "holiday_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "name",
        "kind",
        "day_type",
        "source_ref_index",
        "notes"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "national",
            "religious",
            "administrative_leave"
          ]
        },
        "day_type": {
          "type": "string",
          "enum": [
            "full_day",
            "half_day"
          ]
        },
        "source_ref_index": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": ["string", "null"]
        },
        "observances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observance"
          }
        }
      }
    },

    "observance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observance_id",
        "kind",
        "day_type",
        "legal_basis_ref",
        "block_index"
      ],
      "properties": {
        "observance_id": {
          "type": "string",
          "enum": [
            "yilbasi",
            "ulusal_egemenlik_cocuk_bayrami",
            "emek_dayanisma_gunu",
            "ataturk_anma_genclik_spor_bayrami",
            "demokrasi_milli_birlik_gunu",
            "zafer_bayrami",
            "cumhuriyet_bayrami_arefe",
            "cumhuriyet_bayrami",
            "ramazan_bayrami_arefe",
            "ramazan_bayrami_gun1",
            "ramazan_bayrami_gun2",
            "ramazan_bayrami_gun3",
            "kurban_bayrami_arefe",
            "kurban_bayrami_gun1",
            "kurban_bayrami_gun2",
            "kurban_bayrami_gun3",
            "kurban_bayrami_gun4"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "national",
            "religious"
          ]
        },
        "day_type": {
          "type": "string",
          "enum": [
            "full_day",
            "half_day"
          ]
        },
        "legal_basis_ref": {
          "type": "string",
          "minLength": 1
        },
        "block_index": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },

    "verification_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_ref",
        "document_version",
        "signed_artifact",
        "lawyer",
        "review_date",
        "scope",
        "referenced_source_artifacts",
        "verified_content_digest",
        "notes"
      ],
      "properties": {
        "verification_ref": {
          "type": "string",
          "pattern": "^HC-LAWYER-VERIFY-v1-[0-9]{4}-[0-9]{4}-[0-9a-f]{16}$"
        },
        "document_version": {
          "const": "HC-LAWYER-VERIFY-v1"
        },
        "signed_artifact": {
          "$ref": "#/$defs/signed_artifact"
        },
        "lawyer": {
          "$ref": "#/$defs/verifying_lawyer"
        },
        "review_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "scope": {
          "$ref": "#/$defs/verification_scope"
        },
        "referenced_source_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/referenced_source_artifact"
          }
        },
        "verified_content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },

    "signed_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "format",
        "sha256",
        "size_bytes",
        "signature_method",
        "signature_timestamp",
        "signature_timestamp_source",
        "signature_count_observed",
        "hash_computed_at",
        "stored_in_repository"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": ["udf"]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "signature_method": {
          "type": "string",
          "enum": ["guvenli_elektronik_imza"]
        },
        "signature_timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "signature_timestamp_source": {
          "type": "string",
          "enum": ["uyap_screen_operator_observation"]
        },
        "signature_count_observed": {
          "type": "integer",
          "minimum": 1
        },
        "hash_computed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "stored_in_repository": {
          "const": false
        }
      }
    },

    "verifying_lawyer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name", "bar", "bar_registration_no"],
      "properties": {
        "full_name": {
          "type": "string",
          "minLength": 1
        },
        "bar": {
          "type": "string",
          "minLength": 1
        },
        "bar_registration_no": {
          "type": ["string", "null"]
        }
      }
    },

    "verification_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year_from",
        "year_to",
        "accepted_years",
        "year_decisions",
        "conflict_decision",
        "half_day_policy_decision",
        "final_decision",
        "corrections"
      ],
      "properties": {
        "year_from": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "year_to": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "accepted_years": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          }
        },
        "year_decisions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]{4}$"
          },
          "additionalProperties": {
            "type": "string",
            "enum": ["KABUL", "DUZELTME", "RED"]
          }
        },
        "conflict_decision": {
          "type": "string",
          "enum": ["KABUL", "DUZELTME", "RED"]
        },
        "half_day_policy_decision": {
          "type": "string",
          "enum": [
            "counts_as_holiday",
            "counts_as_working_day",
            "needs_review_if_deadline_day"
          ]
        },
        "final_decision": {
          "type": "string",
          "enum": ["KABUL", "DUZELTMEYLE_KABUL", "KISMEN_KABUL", "RED"]
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },

    "referenced_source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "filename", "sha256", "description"],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "source_observations",
            "normalized_proposal",
            "canonical_registry"
          ]
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "description": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
