{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "holiday_calendar.schema.json",

  "title": "Vergi AI Official Holiday Calendar Schema V1",

  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "calendar_id",
    "calendar_version",
    "effective_from",
    "jurisdiction",
    "weekend_policy",
    "half_day_policy",
    "years",
    "governance",
    "notes"
  ],

  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },

    "calendar_id": {
      "const": "tr_official_holiday_calendar_v1"
    },

    "calendar_version": {
      "type": "integer",
      "minimum": 1
    },

    "effective_from": {
      "type": "string",
      "format": "date"
    },

    "jurisdiction": {
      "const": "TR"
    },

    "weekend_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["non_working_weekdays", "notes"],
      "properties": {
        "non_working_weekdays": {
          "const": [5, 6]
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },

    "half_day_policy": {
      "type": "string",
      "enum": [
        "not_decided",
        "counts_as_holiday",
        "counts_as_working_day"
      ]
    },

    "years": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/year_entry"
      }
    },

    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_approval",
        "verification_authority",
        "notes"
      ],
      "properties": {
        "change_approval": {
          "type": "string",
          "minLength": 1
        },
        "verification_authority": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },

    "notes": {
      "type": ["string", "null"]
    }
  },

  "$defs": {
    "year_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "verified",
        "verification_ref",
        "source_refs",
        "holidays"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "verified": {
          "type": "boolean"
        },
        "verification_ref": {
          "type": ["string", "null"]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "holidays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/holiday_entry"
          }
        }
      }
    },

    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "citation", "url"],
      "properties": {
        "source_kind": {
          "type": "string",
          "minLength": 1
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": ["string", "null"]
        }
      }
    },

    "holiday_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "name",
        "kind",
        "day_type",
        "source_ref_index",
        "notes"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "national",
            "religious",
            "administrative_leave"
          ]
        },
        "day_type": {
          "type": "string",
          "enum": [
            "full_day",
            "half_day"
          ]
        },
        "source_ref_index": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
