{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case_evidence.schema.json",
  "title": "Vergi AI Case Evidence Schema V1",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "evidence_analysis_id",
    "case_id",
    "status",
    "generated_at",
    "analysis_metadata",
    "evidence_coverage",
    "evidence_candidates",
    "evidence_agent_suggestions",
    "warnings",
    "notes"
  ],

  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },

    "evidence_analysis_id": {
      "type": "string",
      "minLength": 1
    },

    "case_id": {
      "type": "string",
      "minLength": 1
    },

    "status": {
      "type": "string",
      "enum": [
        "completed",
        "partial",
        "failed"
      ]
    },

    "generated_at": {
      "type": "string",
      "format": "date-time"
    },

    "analysis_metadata": {
      "$ref": "#/$defs/analysis_metadata"
    },

    "evidence_coverage": {
      "type": "array",
      "description": "HER canonical issue için TAM OLARAK BİR kayıt. Bir evidence candidate DEĞİLDİR ve source_fact_id/source_document_id/relationship_candidate gibi bir alan TAŞIMAZ (yapısal olarak - schema'da böyle bir alan yoktur).",
      "items": {
        "$ref": "#/$defs/coverage_record"
      }
    },

    "evidence_candidates": {
      "type": "array",
      "description": "Bir issue için 0..N adet olabilir. Her biri deterministik allowlist'ten (canonical issue + approved fact + active canonical document + canonical source_location) Agent'ın seçtiği TEK bir supports/contradicts ilişkisini temsil eder. confidence/strength/priority/admissibility alanı YAPISAL OLARAK TANIMLI DEĞİLDİR.",
      "items": {
        "$ref": "#/$defs/evidence_candidate"
      }
    },

    "evidence_agent_suggestions": {
      "type": "array",
      "description": "Gerçek delil DEĞİLDİR; upstream mutation yapamaz; candidate dizisine taşınamaz.",
      "items": {
        "$ref": "#/$defs/agent_suggestion"
      }
    },

    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },

  "$defs": {

    "analysis_metadata": {
      "type": "object",
      "additionalProperties": false,

      "description": "Bu analizde GERÇEKTEN kullanılan canonical girdilerin hash'leri. V1'de kullanılmayan optional timeline/deadline/research/case-law girdileri burada kullanılmış gibi GÖSTERİLMEZ.",

      "required": [
        "issues_input_hash",
        "facts_input_hash",
        "documents_input_hash"
      ],

      "properties": {
        "issues_input_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },

        "facts_input_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },

        "documents_input_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },

    "source_location": {
      "type": "object",
      "additionalProperties": false,

      "description": "İlgili fact'in kendi canonical source locator'ının DETERMİNİSTİK KOPYASI (icat edilemez).",

      "required": [
        "page",
        "section",
        "paragraph",
        "text_excerpt"
      ],

      "properties": {
        "page": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },

        "section": {
          "type": ["string", "null"]
        },

        "paragraph": {
          "type": ["string", "null"]
        },

        "text_excerpt": {
          "type": ["string", "null"]
        }
      }
    },

    "coverage_record": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "coverage_id",
        "source_issue_id",
        "execution_state",
        "allowlist_count",
        "candidate_count",
        "suggestion_count",
        "reason_codes",
        "trigger_rule_id",
        "title",
        "description",
        "confidence",
        "requires_human_review",
        "status",
        "notes"
      ],

      "properties": {
        "coverage_id": {
          "type": "string",
          "minLength": 1
        },

        "source_issue_id": {
          "type": "string",
          "minLength": 1
        },

        "execution_state": {
          "type": "string",
          "description": "BEŞ AYRI ANLAM - birbirine dönüştürülemez. 'blocked_missing_input': issue için resolve edilebilir approved fact + active canonical document YOK (allowlist_count=0). 'analysis_not_run': allowlist_count>=1 ama Agent HİÇ ÇALIŞTIRILMADI. 'analysis_completed': Agent çalıştı ve ilgili issue'nun tüm allowlist kayıtlarını hatasız değerlendirdi (candidate_count=0 olması GEÇERLİDİR). 'analysis_partial': Agent çalıştı ama bazı ham candidate/suggestion önerileri şekil/grounding hatası nedeniyle reddedildi. 'analysis_failed': Agent çağrısı teknik olarak başarısız oldu veya cevap ayrıştırılamadı.",
          "enum": [
            "analysis_not_run",
            "analysis_completed",
            "analysis_partial",
            "blocked_missing_input",
            "analysis_failed"
          ]
        },

        "allowlist_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Bu issue için deterministik olarak üretilmiş (issue, fact, document) allowlist kaydı sayısı."
        },

        "candidate_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Bu coverage kaydına bağlı evidence_candidates öğelerinin GERÇEK sayısı."
        },

        "suggestion_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Bu coverage kaydına bağlı evidence_agent_suggestions öğelerinin GERÇEK sayısı."
        },

        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },

        "trigger_rule_id": {
          "type": "string",
          "minLength": 1
        },

        "title": {
          "type": "string",
          "minLength": 1
        },

        "description": {
          "type": "string",
          "minLength": 1
        },

        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },

        "requires_human_review": {
          "type": "boolean",
          "const": true
        },

        "status": {
          "type": "string",
          "const": "candidate"
        },

        "notes": {
          "type": ["string", "null"]
        }
      }
    },

    "evidence_candidate": {
      "type": "object",
      "additionalProperties": false,

      "description": "confidence/evidence-strength/priority/admissibility alanı KASITLI OLARAK TANIMLANMAMIŞTIR.",

      "required": [
        "candidate_id",
        "source_issue_id",
        "source_fact_id",
        "source_document_id",
        "source_location",
        "source_excerpt",
        "relationship_candidate",
        "reason_code",
        "grounded_explanation",
        "review_state",
        "requires_human_review",
        "status",
        "notes"
      ],

      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },

        "source_issue_id": {
          "type": "string",
          "minLength": 1
        },

        "source_fact_id": {
          "type": "string",
          "minLength": 1,
          "description": "Yalnız approved (canonical facts.json) bir fact_id olabilir."
        },

        "source_document_id": {
          "type": "string",
          "minLength": 1,
          "description": "Yalnız active=true canonical case document_id olabilir; fact'in kendi source_document_id'sinden DETERMİNİSTİK olarak türetilir."
        },

        "source_location": {
          "$ref": "#/$defs/source_location"
        },

        "source_excerpt": {
          "type": ["string", "null"],
          "description": "İlgili fact'in source.text_excerpt alanının DETERMİNİSTİK KOPYASI. Agent tarafından üretilemez/değiştirilemez."
        },

        "relationship_candidate": {
          "type": "string",
          "enum": [
            "supports",
            "contradicts"
          ]
        },

        "reason_code": {
          "type": "string",
          "minLength": 1
        },

        "grounded_explanation": {
          "type": ["string", "null"],
          "description": "reason_code'a bağlı deterministik template ile render edilir; LLM serbest metin yazmaz."
        },

        "review_state": {
          "type": "string",
          "description": "Agent yalnız 'needs_review' üretebilir. 'confirmed'/'rejected' yalnız Layer B human review ile mümkündür.",
          "enum": [
            "needs_review",
            "confirmed",
            "rejected"
          ]
        },

        "requires_human_review": {
          "type": "boolean",
          "const": true
        },

        "status": {
          "type": "string",
          "const": "candidate"
        },

        "notes": {
          "type": ["string", "null"]
        }
      }
    },

    "agent_suggestion": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "suggestion_id",
        "source_issue_id",
        "suggestion_type",
        "source_fact_id",
        "source_document_id",
        "related_reference_ids",
        "reason_code",
        "title",
        "description",
        "trigger_rule_id",
        "confidence",
        "suggestion_review_state",
        "requires_human_review",
        "status",
        "notes"
      ],

      "properties": {
        "suggestion_id": {
          "type": "string",
          "minLength": 1
        },

        "source_issue_id": {
          "type": "string",
          "minLength": 1
        },

        "suggestion_type": {
          "type": "string",
          "enum": [
            "missing_document",
            "fact_evidence_gap",
            "unresolved_conflict",
            "missing_source_location",
            "fact_review_needed",
            "additional_verification"
          ]
        },

        "source_fact_id": {
          "type": ["string", "null"]
        },

        "source_document_id": {
          "type": ["string", "null"]
        },

        "related_reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },

        "reason_code": {
          "type": "string",
          "minLength": 1
        },

        "title": {
          "type": "string",
          "minLength": 1
        },

        "description": {
          "type": "string",
          "minLength": 1
        },

        "trigger_rule_id": {
          "type": "string",
          "minLength": 1
        },

        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },

        "suggestion_review_state": {
          "type": "string",
          "description": "Agent yalnız 'needs_review' üretebilir. 'accepted_for_follow_up'/'dismissed' yalnız Layer B human review ile mümkündür.",
          "enum": [
            "needs_review",
            "accepted_for_follow_up",
            "dismissed"
          ]
        },

        "requires_human_review": {
          "type": "boolean",
          "const": true
        },

        "status": {
          "type": "string",
          "const": "candidate"
        },

        "notes": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
