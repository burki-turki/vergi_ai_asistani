{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case_fact_extraction.schema.json",

  "title": "Vergi AI Case Fact Extraction Schema V1",

  "type": "object",

  "additionalProperties": false,

  "required": [
    "schema_version",
    "extraction_id",
    "case_id",
    "source_document_id",
    "status",
    "extractor",
    "facts",
    "warnings",
    "notes"
  ],

  "properties": {

    "schema_version": {
      "type": "integer",
      "const": 1
    },

    "extraction_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "minLength": 3
    },

    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "minLength": 3
    },

    "source_document_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "minLength": 3
    },

    "status": {
      "type": "string",

      "enum": [
        "pending",
        "completed",
        "partial",
        "failed"
      ]
    },

    "extractor": {
      "$ref": "#/$defs/extractor"
    },

    "facts": {
      "type": "array",

      "items": {
        "$ref": "#/$defs/fact"
      }
    },

    "warnings": {
      "type": "array",

      "items": {
        "type": "string",
        "minLength": 1
      }
    },

    "notes": {
      "$ref": "#/$defs/nullableString"
    }
  },

  "$defs": {

    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },

    "nullableInteger": {
      "type": [
        "integer",
        "null"
      ]
    },

    "nullableNumber": {
      "type": [
        "number",
        "null"
      ]
    },

    "nullableDateTime": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },

    "verificationState": {
      "type": "string",

      "enum": [
        "verified",
        "partially_verified",
        "unverified"
      ]
    },

    "extractor": {
      "type": "object",

      "additionalProperties": false,

      "required": [
        "method",
        "provider",
        "model",
        "extractor_version",
        "prompt_version",
        "run_at"
      ],

      "properties": {

        "method": {
          "type": "string",

          "enum": [
            "manual",
            "rule",
            "llm",
            "hybrid"
          ]
        },

        "provider": {
          "$ref": "#/$defs/nullableString"
        },

        "model": {
          "$ref": "#/$defs/nullableString"
        },

        "extractor_version": {
          "type": "string",
          "minLength": 1
        },

        "prompt_version": {
          "$ref": "#/$defs/nullableString"
        },

        "run_at": {
          "$ref": "#/$defs/nullableDateTime"
        }
      }
    },

    "sourceLocator": {
      "type": "object",

      "additionalProperties": false,

      "required": [
        "page",
        "section",
        "paragraph",
        "text_excerpt"
      ],

      "properties": {

        "page": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },

        "section": {
          "$ref": "#/$defs/nullableString"
        },

        "paragraph": {
          "$ref": "#/$defs/nullableString"
        },

        "text_excerpt": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },

    "moneyValue": {
      "type": "object",

      "additionalProperties": false,

      "required": [
        "amount",
        "currency"
      ],

      "properties": {

        "amount": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d{1,2})?$"
        },

        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },

    "structuredValue": {
      "type": "object",

      "additionalProperties": false,

      "required": [
        "value_type",
        "label",
        "string_value",
        "number_value",
        "date_value",
        "money_value",
        "reference_value"
      ],

      "properties": {

        "value_type": {
          "type": "string",

          "enum": [
            "string",
            "number",
            "date",
            "money",
            "reference"
          ]
        },

        "label": {
          "$ref": "#/$defs/nullableString"
        },

        "string_value": {
          "$ref": "#/$defs/nullableString"
        },

        "number_value": {
          "$ref": "#/$defs/nullableNumber"
        },

        "date_value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },

        "money_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/moneyValue"
            },
            {
              "type": "null"
            }
          ]
        },

        "reference_value": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },

    "fact": {
      "type": "object",

      "additionalProperties": false,

      "required": [
        "fact_id",
        "fact_kind",
        "statement",
        "normalized_statement",
        "extraction_basis",
        "attributed_party_id",
        "attributed_actor_label",
        "source",
        "structured_values",
        "related_party_ids",
        "related_document_ids",
        "related_dispute_item_ids",
        "confidence",
        "verification_state",
        "notes"
      ],

      "properties": {

        "fact_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$",
          "minLength": 3
        },

        "fact_kind": {
          "type": "string",

          "enum": [
            "event",
            "administrative_claim",
            "taxpayer_claim",
            "document_finding",
            "transaction",
            "payment",
            "monetary_fact",
            "date_fact",
            "party_fact",
            "legal_reference",
            "procedural_fact",
            "evidence_reference",
            "other"
          ]
        },

        "statement": {
          "type": "string",
          "minLength": 1
        },

        "normalized_statement": {
          "$ref": "#/$defs/nullableString"
        },

        "extraction_basis": {
          "type": "string",

          "enum": [
            "explicit_text",
            "table",
            "document_metadata",
            "document_structure",
            "derived",
            "unknown"
          ]
        },

        "attributed_party_id": {
          "$ref": "#/$defs/nullableString"
        },

        "attributed_actor_label": {
          "$ref": "#/$defs/nullableString"
        },

        "source": {
          "$ref": "#/$defs/sourceLocator"
        },

        "structured_values": {
          "type": "array",

          "items": {
            "$ref": "#/$defs/structuredValue"
          }
        },

        "related_party_ids": {
          "type": "array",

          "items": {
            "type": "string",
            "minLength": 1
          },

          "uniqueItems": true
        },

        "related_document_ids": {
          "type": "array",

          "items": {
            "type": "string",
            "minLength": 1
          },

          "uniqueItems": true
        },

        "related_dispute_item_ids": {
          "type": "array",

          "items": {
            "type": "string",
            "minLength": 1
          },

          "uniqueItems": true
        },

        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },

        "verification_state": {
          "$ref": "#/$defs/verificationState"
        },

        "notes": {
          "$ref": "#/$defs/nullableString"
        }
      }
    }
  }
}